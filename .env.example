# ====================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# --------------------------------------------------------------------
# Copie el contenido de este archivo en un nuevo archivo llamado .env
# y ajuste los valores según su entorno de desarrollo/producción.
# ====================================================================


# --- 1. CONFIGURACIÓN DEL SERVIDOR DE LA APLICACIÓN ---

# Puerto en el que se ejecutará el servidor API (Backend).
# Asegúrese de que este puerto esté libre en su máquina.
PORT=5000

# Entorno de la aplicación.
# Útil para activar logs o funcionalidades específicas de desarrollo.
NODE_ENV=development


# --- 2. CONFIGURACIÓN DE LA BASE DE DATOS (PRISMA) ---

# URL de conexión a la base de datos. 
# Reemplace [USUARIO], [CONTRASEÑA], [HOST], [PUERTO] y [NOMBRE_DB].
# Si usa PostgreSQL (ejemplo):
# DATABASE_URL="postgresql://[USUARIO]:[CONTRASEÑA]@[HOST]:[PUERTO]/[NOMBRE_DB]?schema=public"
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/user_db"


# --- 3. CONFIGURACIÓN DE SEGURIDAD (JWT) ---

# CLAVE SECRETA para firmar los JSON Web Tokens (JWT).
# ESTA CLAVE DEBE SER ÚNICA, LARGA Y SECRETA para producción.
# El frontend usa esta clave para validar la autenticación.
JWT_SECRET="ClaveSuperSeguraParaFirmarElTokenDeSesion12345!"

# Tiempo de expiración del token de acceso (ej: 1d para 1 día)
JWT_EXPIRES_IN=1d