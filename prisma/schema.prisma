generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id              Int     @id @default(autoincrement())
  nombre          String
  apellidoPaterno String
  apellidoMaterno String
  cedula          String  @unique
  usuario         String  @unique
  contrasena      String
}
